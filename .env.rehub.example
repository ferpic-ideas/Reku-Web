# The same switch gates bot access and selects ReHub credentials.
# Keep test active until the complete production workflow is ready.
CONSULTATION_BOT_MODE=test

# Existing credential set: TEST only (keep current values in the private .env).
REHUB_BASE_URL=https://uxc2aw5mv8.execute-api.eu-west-1.amazonaws.com/dev2
REHUB_CLIENT_ID=
REHUB_PUBLIC_KEY_BASE64=
REHUB_PUBLIC_KEY_PATH=

# PRODUCTION only. Confirm the API base URL with ReHub; never infer it from /dev2.
REHUB_PRODUCTION_BASE_URL=https://f8dheiojk4.execute-api.eu-west-1.amazonaws.com/pro
REHUB_PRODUCTION_CLIENT_ID=
REHUB_PRODUCTION_PUBLIC_KEY_BASE64=
REHUB_PRODUCTION_PUBLIC_KEY_PATH=
# Configure exactly one public-key source per environment.
# Compose already reads .env through env_file. Recreate web after changing mode.
